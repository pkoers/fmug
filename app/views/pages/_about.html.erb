<section class="landing-copy">
  <div>
    <%= render_markdown_content("about.md") %>
  </div>

  <div class="mt-10 flex flex-col items-center gap-4">
    <div class="grid w-full max-w-sm grid-cols-[9rem_1fr] items-center justify-center gap-4">
      <sl-avatar style="--size: 9rem;"
        image="<%= url_for(leadership_avatar_source(@leadership_profile, :chair)) %>"
        label="Avatar of <%= leadership_display_name(@leadership_profile, :chair) %>">
      </sl-avatar>
      <span class="text-left text-xl font-medium text-stone-800"><%= leadership_display_name(@leadership_profile, :chair) %></span>
    </div>

    <div class="grid w-full max-w-sm grid-cols-[9rem_1fr] items-center justify-center gap-4">
      <sl-avatar style="--size: 9rem;"
        image="<%= url_for(leadership_avatar_source(@leadership_profile, :vice_chair)) %>"
        label="Avatar of <%= leadership_display_name(@leadership_profile, :vice_chair) %>"
        loading="lazy">
      </sl-avatar>
      <span class="text-left text-xl font-medium text-stone-800"><%= leadership_display_name(@leadership_profile, :vice_chair) %></span>
    </div>
  </div>
</section>
