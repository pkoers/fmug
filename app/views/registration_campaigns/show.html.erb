<section class="mx-auto w-full max-w-2xl rounded-3xl border border-stone-200 bg-white p-8 shadow-sm">
  <h1 class="text-4xl font-semibold text-stone-900">Launch registration campaign</h1>
  <dl class="mt-6 space-y-3 text-xl text-stone-700">
    <div><dt class="font-semibold">Status</dt><dd><%= @registration_campaign.status.capitalize %></dd></div>
    <div><dt class="font-semibold">Expires</dt><dd><%= @registration_campaign.expires_at.strftime("%b %-d, %Y at %H:%M %Z") %></dd></div>
    <div><dt class="font-semibold">Successful registrations</dt><dd><%= @registration_campaign.successful_registrations_count %> / <%= @registration_campaign.registration_limit %></dd></div>
  </dl>
  <% if @campaign_url.present? %>
    <div class="mt-6 rounded-2xl bg-stone-100 p-4">
      <p class="font-semibold text-stone-900">Copy and distribute this link now. It is shown only at campaign creation.</p>
      <p class="mt-2 break-all text-stone-700"><%= @campaign_url %></p>
    </div>
  <% end %>
  <% if @registration_campaign.accepting_registrations? %>
    <%= button_to "Revoke campaign", revoke_registration_campaign_path(@registration_campaign), method: :post, class: "mt-8 rounded-xl bg-red-600 px-6 py-3 text-lg font-semibold text-white", data: { turbo_confirm: "Revoke this campaign? Existing personal activation links will remain usable." } %>
  <% elsif @registration_campaign.conference.current? && !@active_campaign %>
    <%= link_to "Start new campaign", new_registration_campaign_path, class: "mt-8 inline-flex rounded-xl bg-blue-600 px-6 py-3 text-lg font-semibold text-white" %>
  <% end %>
  <%= link_to "Back to campaigns", registration_campaigns_path, class: "mt-6 inline-flex text-lg text-stone-700 underline" %>
</section>
