<% content_for :title, "Conference registrations" %>

<section class="w-full rounded-[32px] bg-stone-50 p-6 shadow-sm ring-1 ring-stone-200 sm:p-8">
  <div class="flex flex-col gap-4 border-b border-stone-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-lg font-semibold uppercase tracking-[0.24em] text-stone-500">Conference Admin</p>
      <h1 class="mt-2 text-5xl font-semibold tracking-tight text-stone-900">Registrations</h1>
      <p class="mt-3 text-xl text-stone-600">Conference <%= @conference.edition %> — <%= @conference.location %></p>
    </div>
    <%= link_to "Back to conferences", conferences_path, class: "inline-flex items-center justify-center rounded-xl border border-stone-300 px-6 py-4 text-lg font-medium text-stone-700 transition hover:bg-stone-100" %>
  </div>

  <div id="registrations" class="mt-6 space-y-4">
    <% @registrations.each do |registration| %>
      <article class="rounded-[28px] border border-stone-200 bg-white p-5 shadow-sm sm:p-6">
        <h2 class="break-words text-3xl font-semibold text-stone-900"><%= [registration.user.first_name, registration.user.last_name].compact.join(" ") %></h2>
        <p class="mt-2 break-words text-lg text-stone-600"><%= registration.user.email %></p>
        <dl class="mt-5 grid gap-5 text-lg sm:grid-cols-2">
          <div>
            <dt class="font-semibold text-stone-900">Registered on</dt>
            <dd class="mt-1 text-stone-600"><%= registration.created_at.strftime("%b %-d, %Y") %></dd>
          </div>
          <div>
            <dt class="font-semibold text-stone-900">Attendance</dt>
            <dd class="mt-1 text-stone-600"><%= registration_attendance_label(registration) %></dd>
          </div>
          <div class="min-w-0">
            <dt class="font-semibold text-stone-900">Agenda</dt>
            <dd class="mt-1 whitespace-pre-line break-words text-stone-600"><%= registration_agenda_labels(registration).presence&.join("\n") || "No agenda selections provided" %></dd>
          </div>
          <div class="min-w-0">
            <dt class="font-semibold text-stone-900">Dietary requirements</dt>
            <dd class="mt-1 whitespace-pre-line break-words text-stone-600"><%= registration_dietary_label(registration) %></dd>
          </div>
          <div class="min-w-0 sm:col-span-2">
            <dt class="font-semibold text-stone-900">Message for the Chair</dt>
            <dd class="mt-1 whitespace-pre-line break-words text-stone-600"><%= registration.chair_note.presence || "No message provided" %></dd>
          </div>
        </dl>
      </article>
    <% end %>
    <% if @registrations.empty? %>
      <p class="rounded-[28px] border border-dashed border-stone-300 bg-white px-6 py-16 text-center text-xl text-stone-600">No registrations yet for this conference</p>
    <% end %>
  </div>
</section>
